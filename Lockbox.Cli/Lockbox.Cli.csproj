<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 9 as well, so apps that can't move to .NET 10 yet can use the packages. -->
    <TargetFrameworks>net9.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>Lockbox.Cli</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Lockbox.Cli</PackageId>
    <Version>0.3.0</Version>
    <Description>set-credentials, verify-credentials and show-credentials-info commands for console apps that use Lockbox.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockbox\Lockbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lockbox.Tests" />
  </ItemGroup>

</Project>
