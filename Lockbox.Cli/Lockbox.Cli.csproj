<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Lockbox.Cli</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Lockbox.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>set-credentials, verify-credentials and show-credentials-info commands for console apps that use Lockbox.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockbox\Lockbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lockbox.Tests" />
  </ItemGroup>

</Project>
