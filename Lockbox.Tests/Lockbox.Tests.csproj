<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows;net10.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- CA1861 (cache constant arrays) is a performance rule; inline expected values read better in tests. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockbox\Lockbox.csproj" />
    <ProjectReference Include="..\Lockbox.Cli\Lockbox.Cli.csproj" />
    <ProjectReference Include="..\Lockbox.Setup\Lockbox.Setup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
