<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <!-- WinForms and DPAPI need Windows. Elsewhere the project still builds, but dotnet test skips it. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockbox.Setup.WinForms\Lockbox.Setup.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
