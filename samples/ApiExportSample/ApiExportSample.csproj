<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- A consuming app in another solution would use the Lockbox and Lockbox.Cli packages instead. -->
    <ProjectReference Include="..\..\Lockbox\Lockbox.csproj" />
    <ProjectReference Include="..\..\Lockbox.Cli\Lockbox.Cli.csproj" />
    <ProjectReference Include="..\SampleSupport\SampleSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ApiExportSample.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Samples.Tests" />
  </ItemGroup>

</Project>
